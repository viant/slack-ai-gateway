#package('github.com/viant/agently-slack-gateway/internal/storage/mysql/graph/operations/check')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/operations/check','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $AppID<string>(query/appId).Optional())
#define($_ = $WorkspaceID<string>(query/workspaceId).Optional())
#define($_ = $ChannelID<string>(query/channelId).Optional())
#define($_ = $FixedChannel<bool>(query/fixedChannel).Optional())
#define($_ = $Principal<string>(query/principal).Optional())
#define($_ = $Data<[]*IdentityCheck>(output/view))

SELECT identity_check.*, type(identity_check,'IdentityCheck')
FROM (${embed:sql/check.sql}) identity_check
