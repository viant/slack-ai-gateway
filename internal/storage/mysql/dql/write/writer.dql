#package('github.com/viant/agently-slack-gateway/internal/storage/mysql/graph/write')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/jobs','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $ExpectedState<string>(query/expectedState).Optional().WithPredicate(7,'equal','inbox_jobs','state'))
#define($_ = $Jobs<[]*Job>(body/data))
#define($_ = $Data<[]*Job>(output/body))

SELECT jobs.*, status.*, outbox.*,
       type(jobs,'Job'), mutation_predicate(jobs,7), type(status,'RequestStatus'), type(outbox,'Outbox')
FROM (SELECT * FROM inbox_jobs j) jobs
LEFT JOIN request_status status ON status.job_id=jobs.id AND 1=1
LEFT JOIN outbox_messages outbox ON outbox.job_id=jobs.id
