#package('github.com/viant/slack-ai-gateway/internal/datly/bindings/write')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/bindings','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
