#package('github.com/viant/agently-slack-gateway/internal/datly/read')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/jobs','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $Mode<string>(query/mode).Optional().Value('key'))
#define($_ = $Now<int64>(query/now).Optional())
#define($_ = $ID<int64>(query/ID).Optional().WithPredicate(0,'equal','j','id'))
#define($_ = $AppID<string>(query/AppID).Optional().WithPredicate(0,'equal','j','app_id'))
#define($_ = $EventID<string>(query/EventID).Optional().WithPredicate(0,'equal','j','event_id'))
#define($_ = $State<string>(query/State).Optional().WithPredicate(0,'equal','j','state'))
#define($_ = $WorkspaceID<string>(query/WorkspaceID).Optional().WithPredicate(0,'equal','j','workspace_id'))
#define($_ = $ChannelID<string>(query/ChannelID).Optional().WithPredicate(0,'equal','j','channel_id'))
#define($_ = $RootThreadTS<string>(query/RootThreadTS).Optional().WithPredicate(0,'equal','j','root_thread_ts'))
#define($_ = $RequestID<string>(query/RequestID).Optional().WithPredicate(0,'equal','j','request_id'))
#define($_ = $Data<[]*Job>(output/view))

SELECT jobs.*, binding.*, status.*, outbox.*, resolutions.*,
       type(jobs,'Job'), type(binding,'Binding'),
       CAST(jobs.earlier AS int), CAST(jobs.blocked AS int),
       type(status,'RequestStatus'), type(outbox,'Outbox'), type(resolutions,'Resolution'),
       row_lock(jobs,'inbox_jobs j','j.id'),
       set_limit(jobs,0), set_limit(outbox,0), set_limit(resolutions,0)
FROM (${embed:sql/jobs.sql}) jobs
LEFT JOIN conversation_bindings binding ON binding.id=jobs.binding_id AND 1=1
LEFT JOIN request_status status ON status.job_id=jobs.id AND 1=1
LEFT JOIN outbox_messages outbox ON outbox.job_id=jobs.id
LEFT JOIN delivery_resolutions resolutions ON resolutions.delivery_id=outbox.id
