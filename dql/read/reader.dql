#package('github.com/viant/slack-ai-gateway/internal/datly/read')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/jobs','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))


#define($_ = $IntegrationID<int>(query/IntegrationID).Optional().Value(0))
#define($_ = $IntegrationName<string>(query/IntegrationName).Optional().Value(''))
#define($_ = $Mode<string>(query/mode).Optional().Value('key'))
#define($_ = $Now<time.Time>(query/now).Optional())
#define($_ = $ID<int64>(query/ID).Optional().WithPredicate(0,'equal','j','id'))
#define($_ = $AppID<string>(query/AppID).Optional().WithPredicate(1,'equal','integration','slack_app_id'))
#define($_ = $EventID<string>(query/EventID).Optional().WithPredicate(0,'equal','j','slack_event_id'))
#define($_ = $State<string>(query/State).Optional().WithPredicate(0,'equal','j','gateway_execution_state'))
#define($_ = $WorkspaceID<string>(query/WorkspaceID).Optional().WithPredicate(1,'equal','integration','slack_workspace_id'))
#define($_ = $ChannelID<string>(query/ChannelID).Optional().WithPredicate(0,'equal','j','slack_channel_id'))
#define($_ = $SlackThreadRootMessageID<string>(query/SlackThreadRootMessageID).Optional().WithPredicate(0,'equal','j','slack_thread_root_message_id'))
#define($_ = $GatewayRequestID<string>(query/GatewayRequestID).Optional().WithPredicate(0,'equal','j','gateway_request_id'))
#define($_ = $Data<[]*GatewayJob>(output/view))

SELECT gateway_jobs.*, conversation_binding.*, slack_outgoing_messages.*, slack_delivery_resolutions.*,
       type(gateway_jobs,'GatewayJob'), required(gateway_jobs.slack_app_id), required(gateway_jobs.slack_workspace_id),
       required(gateway_jobs.integration_name), required(gateway_jobs.integration_active), required(gateway_jobs.integration_principal_id),
       CAST(gateway_jobs.integration_active AS int), type(conversation_binding,'ConversationBinding'),
       CAST(gateway_jobs.earlier AS int), CAST(gateway_jobs.blocked AS int),
       type(slack_outgoing_messages,'SlackOutgoingMessage'), type(slack_delivery_resolutions,'SlackDeliveryResolution'),
       row_lock(gateway_jobs,'gateway_job j','j.id'),
       set_limit(gateway_jobs,0), set_limit(slack_outgoing_messages,0), set_limit(slack_delivery_resolutions,0)
FROM (${embed:sql/jobs.sql}) gateway_jobs
LEFT JOIN (${embed:sql/binding.sql}) conversation_binding ON conversation_binding.integration_id=gateway_jobs.integration_id AND conversation_binding.id=gateway_jobs.conversation_binding_id AND 1=1
LEFT JOIN slack_outgoing_message slack_outgoing_messages ON slack_outgoing_messages.job_id=gateway_jobs.id
LEFT JOIN slack_delivery_resolution slack_delivery_resolutions ON slack_delivery_resolutions.outgoing_message_id=slack_outgoing_messages.id
