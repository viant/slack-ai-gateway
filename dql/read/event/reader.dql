#package('github.com/viant/slack-ai-gateway/internal/datly/read/event')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/events/exists','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))


#define($_ = $EventID<string>(query/EventID).Required())
#define($_ = $Data<[]*EventIdentity>(output/view))

SELECT identity.*, type(identity,'EventIdentity'), CAST(identity.found AS int), required(identity.found)
FROM (SELECT CASE WHEN EXISTS(SELECT 1 FROM gateway_job j WHERE j.slack_event_id=$EventID) THEN 1 ELSE 0 END AS found) identity
