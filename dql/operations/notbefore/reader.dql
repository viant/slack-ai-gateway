#package('github.com/viant/slack-ai-gateway/internal/datly/operations/notbefore')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/operations/notbefore','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $IntegrationID<int>(query/IntegrationID).Optional().Value(0))
#define($_ = $AppID<string>(query/appId).Optional().Value(''))
#define($_ = $WorkspaceID<string>(query/workspaceId).Optional())
#define($_ = $Data<[]*Cooldown>(output/view))

SELECT cooldown.*, type(cooldown,'Cooldown')
FROM (${embed:sql/cooldown.sql}) cooldown
