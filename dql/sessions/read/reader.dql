#package('github.com/viant/slack-ai-gateway/internal/datly/sessions/read')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/sessions','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))


#define($_ = $IntegrationID<int>(query/IntegrationID).Optional().Value(0))
#define($_ = $AppID<string>(query/AppID).Optional())
#define($_ = $WorkspaceID<string>(query/WorkspaceID).Optional())
#define($_ = $ChannelID<string>(query/ChannelID).Optional())
#define($_ = $SlackThreadRootMessageID<string>(query/SlackThreadRootMessageID).Optional())
#define($_ = $Mode<string>(query/mode).Optional().Value('key'))
#define($_ = $Data<[]*SlackAgentSessionPublication>(output/view))

SELECT slack_agent_session_publications.*, gateway_jobs.*, type(slack_agent_session_publications,'SlackAgentSessionPublication'), required(slack_agent_session_publications.slack_app_id), required(slack_agent_session_publications.slack_workspace_id), type(gateway_jobs,'GatewayJobSessionProjection'), row_lock(slack_agent_session_publications,'slack_agent_session_publication a','a.id'),
       CAST(gateway_jobs.slack_progress_mode AS string), CAST(gateway_jobs.backend_observed_state AS string), CAST(gateway_jobs.binding_state AS string),
       CAST(gateway_jobs.pending AS *int), CAST(gateway_jobs.bad AS *int), CAST(gateway_jobs.integration_active AS *int),
       set_limit(slack_agent_session_publications,0), set_limit(gateway_jobs,0)
FROM (${embed:sql/sessions.sql}) slack_agent_session_publications
LEFT JOIN (${embed:sql/jobs.sql}) gateway_jobs ON gateway_jobs.slack_app_id=slack_agent_session_publications.slack_app_id AND gateway_jobs.slack_workspace_id=slack_agent_session_publications.slack_workspace_id AND gateway_jobs.slack_channel_id=slack_agent_session_publications.slack_channel_id AND gateway_jobs.slack_thread_root_message_id=slack_agent_session_publications.slack_thread_root_message_id
