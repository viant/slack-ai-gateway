#package('github.com/viant/slack-ai-gateway/internal/datly/sessions/write')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/sessions','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $Rows<[]*SlackAgentSessionPublication>(body/data))
#define($_ = $Data<[]*SlackAgentSessionPublication>(output/body))

SELECT slack_agent_session_publications.*,type(slack_agent_session_publications,'SlackAgentSessionPublication') FROM slack_agent_session_publication slack_agent_session_publications
