#package('github.com/viant/slack-ai-gateway/internal/datly/deliveries/read')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/deliveries','GET'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))


#define($_ = $IntegrationID<int>(query/IntegrationID).Optional().Value(0))
#define($_ = $IntegrationName<string>(query/IntegrationName).Optional().Value(''))
#define($_ = $ID<int64>(query/ID).Optional())
#define($_ = $Mode<string>(query/mode).Optional().Value('key'))
#define($_ = $Now<time.Time>(query/now).Optional())
#define($_ = $Data<[]*SlackOutgoingMessage>(output/view))

SELECT slack_outgoing_messages.*, gateway_job.*, conversation_binding.*, slack_delivery_resolutions.*,
 type(slack_outgoing_messages,'SlackOutgoingMessage'), required(slack_outgoing_messages.slack_app_id), required(slack_outgoing_messages.slack_workspace_id),
 required(slack_outgoing_messages.integration_name), required(slack_outgoing_messages.integration_active), required(slack_outgoing_messages.integration_principal_id),
 CAST(slack_outgoing_messages.integration_active AS int), type(gateway_job,'GatewayJob'), type(conversation_binding,'ConversationBinding'), type(slack_delivery_resolutions,'SlackDeliveryResolution'),
 row_lock(slack_outgoing_messages,'slack_outgoing_message m','m.id'), set_limit(slack_outgoing_messages,0), set_limit(slack_delivery_resolutions,0)
FROM (${embed:sql/deliveries.sql}) slack_outgoing_messages
LEFT JOIN (${embed:sql/job.sql}) gateway_job ON gateway_job.id=slack_outgoing_messages.job_id AND 1=1
LEFT JOIN (${embed:sql/binding.sql}) conversation_binding ON conversation_binding.integration_id=gateway_job.integration_id AND conversation_binding.id=gateway_job.conversation_binding_id AND 1=1
LEFT JOIN slack_delivery_resolution slack_delivery_resolutions ON slack_delivery_resolutions.outgoing_message_id=slack_outgoing_messages.id
