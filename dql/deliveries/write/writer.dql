#package('github.com/viant/slack-ai-gateway/internal/datly/deliveries/write')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/deliveries','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $Rows<[]*SlackOutgoingMessage>(body/data))
#define($_ = $Data<[]*SlackOutgoingMessage>(output/body))

SELECT slack_outgoing_messages.*, slack_delivery_resolutions.*, type(slack_outgoing_messages,'SlackOutgoingMessage'), type(slack_delivery_resolutions,'SlackDeliveryResolution')
FROM slack_outgoing_message slack_outgoing_messages
LEFT JOIN slack_delivery_resolution slack_delivery_resolutions ON slack_delivery_resolutions.outgoing_message_id=slack_outgoing_messages.id
