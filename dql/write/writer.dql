#package('github.com/viant/slack-ai-gateway/internal/datly/write')

#setting($_ = $connector('slack'))
#setting($_ = $internal(true))
#setting($_ = $route('/internal/gateway/jobs','PATCH'))
#setting($_ = $input_type('Input'))
#setting($_ = $output_type('Output'))
#setting($_ = $case_format('lc'))

#define($_ = $ExpectedState<string>(query/expectedState).Optional().WithPredicate(7,'equal','gateway_job','gateway_execution_state'))
#define($_ = $GatewayJobs<[]*GatewayJob>(body/data))
#define($_ = $Data<[]*GatewayJob>(output/body))

SELECT gateway_jobs.*, slack_outgoing_messages.*,
       type(gateway_jobs,'GatewayJob'), mutation_predicate(gateway_jobs,7), type(slack_outgoing_messages,'SlackOutgoingMessage')
FROM (SELECT * FROM gateway_job j) gateway_jobs
LEFT JOIN slack_outgoing_message slack_outgoing_messages ON slack_outgoing_messages.job_id=gateway_jobs.id
